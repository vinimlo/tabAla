{
  "name": "tabala",
  "version": "1.2.1",
  "description": "Salve abas. Organize em coleções. Processe quando quiser.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{ts,svelte,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,svelte,css,html}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "generate-icons": "node scripts/generate-icons.js"
  },
  "dependencies": {
    "svelte": "5.53.3",
    "svelte-dnd-action": "0.9.69",
    "webextension-polyfill": "0.12.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.3.0",
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "4.0.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/svelte": "5.3.1",
    "@types/chrome": "0.1.37",
    "@types/node": "25.3.0",
    "@types/webextension-polyfill": "0.12.5",
    "@typescript-eslint/eslint-plugin": "8.56.1",
    "@typescript-eslint/parser": "8.56.1",
    "@vitest/coverage-v8": "3.2.4",
    "@vitest/ui": "3.2.4",
    "eslint": "10.0.2",
    "eslint-plugin-svelte": "3.15.0",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "prettier": "3.8.1",
    "prettier-plugin-svelte": "3.5.0",
    "sharp": "0.34.5",
    "svelte-check": "4.4.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1",
    "vite": "5.4.21",
    "vitest": "3.2.4"
  },
  "overrides": {
    "minimatch": "10.2.2",
    "esbuild": "0.25.12"
  }
}
